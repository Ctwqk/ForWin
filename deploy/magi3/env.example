# ForWin on magi3 -- key names only; optional values default in Compose.
# Copy to deploy/magi3/.env on magi3 and fill in the secrets. Never commit .env.
#   install -m 600 deploy/magi3/env.example deploy/magi3/.env
# The stack is invoked from the repository root with:
#   docker compose -f deploy/magi3/docker-compose.yml \
#     --env-file deploy/magi3/.env -p forwin <command>

# --- Required data-store secret -------------------------------------------
FORWIN_POSTGRES_PASSWORD=

# --- LLM profiles ----------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# --- Publisher browser and extension --------------------------------------
FORWIN_PUBLISHER_EXTENSION_API_KEY=
FORWIN_PUBLISHER_SESSION_SECRET=
FORWIN_PUBLISHER_SESSION_ENCRYPTION_REQUIRED=
FORWIN_PUBLISHER_PREFERRED_CLIENT_ID=
FORWIN_PUBLISHER_STRICT_PREFERRED_CLIENT=
FORWIN_PUBLISHER_HEARTBEAT_STALE_SECONDS=
FORWIN_PUBLISHER_HEARTBEAT_MONITOR_INTERVAL_SECONDS=
FORWIN_PUBLISHER_HEARTBEAT_MONITOR_FAILURES=
FORWIN_EXTENSION_TEST_PROFILE=
FORWIN_EXTENSION_REQUIRE_QUALIFIED_PROFILE=
FORWIN_EXTENSION_AUTO_QUALIFY_PROFILE=
FORWIN_EXTENSION_RESTORE_BACKEND_SESSIONS=
FORWIN_EXTENSION_STARTUP_HEARTBEAT_TIMEOUT_SECONDS=
FORWIN_EXTENSION_DISPLAY_MODE=
FORWIN_EXTENSION_DISPLAY=
FORWIN_EXTENSION_XVFB_SERVER_NUM=
FORWIN_EXTENSION_NO_SANDBOX=
FORWIN_EXTENSION_TEST_REMOTE_DEBUGGING_ADDRESS=
FORWIN_EXTENSION_TEST_REMOTE_DEBUGGING_PORT=

# --- In-network endpoints (compose service names, never an IP) ------------
FORWIN_DATABASE_URL=
FORWIN_QDRANT_URL=
FORWIN_QDRANT_COLLECTION=
FORWIN_LLM_KB_QDRANT_COLLECTION=
FORWIN_RETRIEVAL_BACKEND=
FORWIN_ARTIFACT_BACKEND=
FORWIN_ARTIFACT_ROOT=
FORWIN_RUNTIME_SETTINGS_PATH=

# --- HTTP and MCP ----------------------------------------------------------
FORWIN_HTTP_BIND=
FORWIN_MCP_HOST=
FORWIN_MCP_PORT=
FORWIN_MCP_API_TIMEOUT_SECONDS=
FORWIN_ALLOW_BIND_ALL_INTERFACES=
FORWIN_ALLOW_UNAUTHENTICATED_LAN=

# --- Embeddings ------------------------------------------------------------
# The compose stack has no external embedding gateway. Keep the local hash
# backend unless a separate in-network embedding service is added.
FORWIN_EMBEDDING_BACKEND=
FORWIN_EMBEDDING_DIMS=
FORWIN_EMBEDDING_REQUIRED=

# --- Project review policy (stored per project, not environment flags) ------
# Use the project's runtime-policy drawer/API to choose quality_profile
# (standard/pulp), pause.review_interval_chapters, pause.manual_checkpoints,
# pause.band_checkpoint_action and pause.gate_delegate.
# The stored RuntimePolicy.review controls signals, repair_scopes, max_rewrites
# and blocking_rewrites; quality_profile supplies their preset values.

# --- Image build -----------------------------------------------------------
# Optional. Leave empty to use the default package index.
PIP_INDEX_URL=
